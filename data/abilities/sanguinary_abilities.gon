}

BloodFeast {
    template self_buff

    meta {
        name "ABILITY_SANGUINARY_BLOOD_FEAST_NAME"
        desc "ABILITY_SANGUINARY_BLOOD_FEAST_DESC"
        ability_icon Huddle
        class Sanguinary
        type_icon "misc"
    }

    graphics {
        animation angry
    }

    cost {
        infcantrip true
        mana 3
    }

    damage_instance {
        effects {
            Bloodzerked 1
        }
